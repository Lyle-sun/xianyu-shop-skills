# 闲鱼店铺配置。首次设置时复制到 ~/.config/xianyu-shop/shop-config.env（或店铺目录下），按引导填写。
# 这里不放任何密码、token、API Key。易店 token 由店主本人放到 ~/.config/yidian/token。

# —— 店铺 ——
SHOP_DIR="$HOME/xianyu-shop"          # 店铺目录：任务单、日志、成品、数据都在这里
YIDIAN_NICK="你的闲鱼店铺昵称"           # 易店里绑定的店铺名
YIDIAN_ADDRESS="[1, 35, 408]"           # 发货地级联 id
YIDIAN_LABEL="主店"                     # 主店在工作台里的显示名
# 多个闲鱼店：每个店一个易店账号。账号代号用小写英文，token 由店主放 ~/.config/yidian/token-<代号>
YIDIAN_ACCOUNTS=""                      # 例："b"；多个用空格隔开
# YIDIAN_NICK_b="第二个店在易店里的昵称"
# YIDIAN_LABEL_b="二店"
# FEISHU_ACCOUNT_b="账号2"              # 这家店在飞书选品表、线索库「账号」列里的标记
BENCHMARK_SHOPS="对标店1,对标店2,对标店3" # 对标店，第一个是主对标

# —— 角色：谁干哪一步。可选值 dsh / codex / claude，或你自己在下面加的 agent 名 ——
ROLE_SOURCER="dsh"     # 查货源、下载、转页面图、做发货链接（管网盘）
ROLE_WRITER="dsh"      # 写标题和正文
ROLE_DESIGNER="codex"  # 出主图和配图
ROLE_PUBLISHER="dsh" # 上架（店主审品后，按 templates/publish.md）
ROLE_COORDINATOR="claude" # 总调度：派活、验收、改 skill

# —— 每个 agent 怎么启动。{TASK} 换成任务单的绝对路径 ——
AGENT_dsh='zsh -ic "cd \"$SHOP_DIR\" && dsh headless \"请完整读取并严格执行 {TASK}。\""'
AGENT_codex='codex exec -C "$SHOP_DIR" -s danger-full-access --skip-git-repo-check "请完整读取并严格执行 {TASK}。"'
AGENT_claude='self'    # self = 由当前对话里的 agent 自己做，不另起进程

# —— 默认值 ——
PRICE_MIN="0.1"        # 新品随机定价区间（元）
PRICE_MAX="1.9"
DAILY_LIMIT="10"       # 每天最多上几个新品，超过要店主点头
GAP_SECONDS="20-40"    # 连续上架时每个品之间的随机间隔

# —— 飞书（可选，没有就留空）——
FEISHU_BASE=""         # 多维表格 base_token
FEISHU_TABLE_SELECT="" # 「选品」表 id
FEISHU_TABLE_LEADS=""  # 「线索库」表 id
SHOP_ACCOUNT=""        # 本店在飞书里的账号标记（如「账号1」）；写选品表、线索库时「账号」列填它
FEISHU_WIKI_REPORTS_NODE="" # 知识库里本账号「选品报告」目录的 node_token；选品报告写完同步到这里

# —— 夸克（文件夹 fid，可选）——
QUARK_FROM_SHARE_FID=""   # 「来自：分享」
QUARK_LIBRARY_FID=""      # 「虚拟资料」
QUARK_QUARANTINE_FID=""   # 「已剔除-品牌IP（勿上架）」

# —— Word 转页面图用的 LibreOffice 配置目录（含中文字体）——
LO_PROFILE="$HOME/.config/xianyu-shop/lo-profile"   # setup/setup-libreoffice.sh 会建好

# —— 给人看的文档（可选）——
FEISHU_MANUAL_DOC=""     # 流程说明文档 docx id，改 skill 后同步
FEISHU_APPENDIX_DOC=""   # 附录页（skill 全文）docx id

# —— 工作台（可选，单独的仓库）——
WORKBENCH_DIR="$HOME/Desktop/xianyu-shop-workbench"
